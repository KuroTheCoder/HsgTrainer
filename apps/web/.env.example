# Copy to .env.local and set per environment.
# In local dev this stays empty — Vite proxies /api to the local Worker (see vite.config.ts).
# In production (Cloudflare Pages SPA + standalone Worker) set it to the Worker's public URL,
# e.g. https://hsg-trainer-api.<your-subdomain>.workers.dev
VITE_API_BASE=
